<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFA080">

    <!-- Primary Game Scroll View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <!-- Top Header Row matching screenshot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Top Left Badge with Remaining Enemy Target Cells (Matching Screenshot "9") -->
                <TextView
                    android:id="@+id/tv_enemy_remaining_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/badge_score_pill"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="17"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Center Turn Status -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_active_turn_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR TURN • AIM CANNON"
                        android:textColor="#261A18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_turn_status_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap target cell on blue radar to fire cannon"
                        android:textColor="#5A3A34"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Turn Counter Badge -->
                <TextView
                    android:id="@+id/tv_turn_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/badge_score_pill"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="T1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- DSA Tactical Controls: Salvo Queue (FIFO) & Graph Cluster Analysis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_salvo_queue"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary_bg"
                    android:letterSpacing="0.03"
                    android:text="🎯 SALVO QUEUE (FIFO)"
                    android:textAllCaps="false"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_graph_scan"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_secondary_bg"
                    android:letterSpacing="0.03"
                    android:text="☍ GRAPH CLUSTERS"
                    android:textAllCaps="false"
                    android:textColor="@color/dsa_purple"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 1. Top Enemy Ocean Board (Vibrant Blue matching Screenshot) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ocean_grid_board_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tv_opponent_board_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="ENEMY RADAR (TARGET GRID)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Column Labels Header -->
                <LinearLayout
                    android:id="@+id/layout_opponent_col_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Row Labels + Opponent Firing GridLayout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layout_opponent_row_labels"
                        android:layout_width="18dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical" />

                    <GridLayout
                        android:id="@+id/grid_opponent_firing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="10"
                        android:rowCount="10" />
                </LinearLayout>
            </LinearLayout>

            <!-- Middle Fleet Arsenal Status Bar (Matching Screenshot Mini Ships) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2E3C54"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="ENEMY FLEET STATUS (SUNK = BLACK)"
                    android:textColor="#A0B0C8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <com.example.ui.ShipDockView
                    android:id="@+id/dock_combat_fleet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 2. Bottom Player Defense Board (Warm Coral matching Screenshot) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/grid_board_bg"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_player_board_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="6dp"
                    android:letterSpacing="0.08"
                    android:text="YOUR FLEET (DEFENSE STATUS)"
                    android:textColor="#261A18"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Column Labels Header -->
                <LinearLayout
                    android:id="@+id/layout_defense_col_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Row Labels + Defense GridLayout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layout_defense_row_labels"
                        android:layout_width="18dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical" />

                    <GridLayout
                        android:id="@+id/grid_player_defense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="10"
                        android:rowCount="10" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Naval Artillery Cannon Container (Matching Screenshot) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="center">

                <!-- The Interactive Mortar Cannon -->
                <com.example.ui.CannonView
                    android:id="@+id/cannon_view"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center" />

                <!-- Bottom Center Cancel Button (White circle with X) -->
                <ImageButton
                    android:id="@+id/btn_game_cancel"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/button_circle_reset"
                    android:contentDescription="Return to menu"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />

                <!-- Bottom Right Badge with Remaining Friendly Health (Matching Screenshot "17") -->
                <TextView
                    android:id="@+id/tv_player_remaining_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/badge_score_pill"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="17"
                    android:textColor="#FF7043"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Combat Battle Log -->
            <TextView
                android:id="@+id/tv_battle_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_secondary_bg"
                android:padding="8dp"
                android:text="Combat Log: Batteries armed. Tap blue radar to fire cannon."
                android:textColor="@color/text_subtitle"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Full-Screen Combat Effect Overlay for Cannonball Ballistics & Crosshairs -->
    <com.example.ui.CombatEffectOverlayView
        android:id="@+id/overlay_combat_effects"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pass & Play Privacy Curtain Overlay -->
    <LinearLayout
        android:id="@+id/layout_pass_curtain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0243144"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Curtain Icon"
            android:src="@drawable/ic_warship_launcher_1792642084994" />

        <TextView
            android:id="@+id/tv_curtain_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PASS DEVICE TO PLAYER 2"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Radar privacy shield is active.\nDo not look at the screen while passing."
            android:textColor="@color/text_subtitle"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_reveal_turn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/button_random_pill"
            android:letterSpacing="0.06"
            android:text="I AM READY - REVEAL RADAR"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Game Over Victory Overlay (Without DSA concepts) -->
    <LinearLayout
        android:id="@+id/layout_game_over"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6243144"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="Victory Trophy"
            android:src="@drawable/ic_warship_launcher_1792642084994" />

        <TextView
            android:id="@+id/tv_game_over_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MISSION ACCOMPLISHED!"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_game_over_winner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="PLAYER 1 WINS THE BATTLE"
            android:textColor="@color/cyan_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_game_over_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Total Turns: 24\nAccuracy: 72%\nEnemy Fleet Annihilated"
            android:textColor="@color/text_subtitle"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_play_again"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_random_pill"
            android:letterSpacing="0.06"
            android:text="PLAY AGAIN ↺"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_return_main_menu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_secondary_bg"
            android:text="RETURN TO MAIN MENU"
            android:textColor="@color/text_subtitle"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
