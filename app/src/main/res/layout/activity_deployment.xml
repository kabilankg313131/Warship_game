<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E3C54"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Title matching reference screenshot -->
        <TextView
            android:id="@+id/tv_deploy_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deploy your ships"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle matching reference screenshot -->
        <TextView
            android:id="@+id/tv_deploy_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Drag to move and tap to rotate or try\nrandom placement"
            android:textColor="#A0B0C8"
            android:textSize="13sp" />

        <!-- Action Row: RANDOM (Backtracking) and UNDO (LIFO Stack) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_random_placement"
                android:layout_width="135dp"
                android:layout_height="46dp"
                android:background="@drawable/button_random_pill"
                android:letterSpacing="0.06"
                android:text="RANDOM"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_undo_stack"
                android:layout_width="145dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/button_secondary_bg"
                android:enabled="false"
                android:letterSpacing="0.04"
                android:text="UNDO ↶ (0)"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card Container combining Dock (Top) and Grid Board (Bottom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ships Dock with all 5 distinct warships -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dock_card_bg"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <com.example.ui.ShipDockView
                    android:id="@+id/dock_ships_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <!-- Board Grid matching reference screenshot warm styling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/grid_board_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <GridLayout
                    android:id="@+id/grid_deployment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="10"
                    android:rowCount="10" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Actions Row: Circular Reset Button + Confirm Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Circular Reset Button with (X) icon matching screenshot -->
            <ImageButton
                android:id="@+id/btn_reset_circle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/button_circle_reset"
                android:contentDescription="Reset Fleet"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

            <!-- Orientation toggle helper -->
            <Button
                android:id="@+id/btn_rotate_toggle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary_bg"
                android:text="Orientation: Horizontal ↻"
                android:textAllCaps="false"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Start Game Button (Requested by User) -->
            <Button
                android:id="@+id/btn_confirm_fleet"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/button_random_pill"
                android:enabled="false"
                android:letterSpacing="0.06"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="START GAME ➔"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Status Hint -->
        <TextView
            android:id="@+id/tv_deploy_status_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Select a warship above or tap RANDOM to auto-place"
            android:textColor="#A0B0C8"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
